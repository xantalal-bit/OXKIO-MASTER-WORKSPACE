rules_version = '2';

// OXKIO FAMILY BETA V0.1 — minimal, fail-closed Firestore rules for the
// production project (oxkio-9af40). Written on agent/oxkio-autonomy-bootstrap.
//
// Scope: this covers only the 7 collections the frontend (app/index.html)
// actually reads or writes today, per the collection map in the delivery
// report. Every one of them stores a single top-level "user" field holding
// the owning Firebase Auth UID, and the client already filters every read
// with where("user", "==", currentUser.uid) — but the client filter is
// never trusted here; every rule re-derives ownership from request.auth.uid
// and the document's own data.
//
// Security model: Firebase Auth + membership + ownership. Being signed in
// is not enough — open self-registration in the frontend (a UX gate only,
// not a security boundary) means anyone could otherwise create a Firebase
// Auth account and, absent this check, get full self-scoped read/write on
// their own documents in all 7 collections regardless of whether they were
// actually invited to Family Beta. isOxkioMember() closes that gap: it
// requires a request.auth.token.oxkio_member == true custom claim, which is
// only ever set server-side by an operator via the Admin SDK (see
// scripts/firebase-admin/set-oxkio-membership.js) — never by the client, and
// never inferred from anything the client controls. A signed-in caller
// without that claim (e.g. a fresh, uninvited self-registration) is denied
// on every collection below, even for documents they themselves would own.
//
// No admin bypass is granted anywhere in this file. The audit found zero
// code path where Jose (or anyone) reads or writes another user's documents
// in these 7 collections — every existing query is already self-scoped, for
// every user including Jose. request.auth.token.oxkio_role ('admin' or
// 'family_member', set alongside oxkio_member) exists for backend/UI use
// only and is deliberately not consulted here: V0.1 gives admin no access to
// other users' data. If a future feature needs Jose to read family
// documents administratively, that would be a new, separate rule reviewed
// at that time — not a speculative addition now.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Signed in AND explicitly invited into Family Beta via the
    // oxkio_member custom claim (set only by scripts/firebase-admin/
    // set-oxkio-membership.js through the Admin SDK). Authentication alone
    // is never sufficient.
    function isOxkioMember() {
      return isSignedIn() && request.auth.token.oxkio_member == true;
    }

    // The document as it exists before this request belongs to the caller.
    function ownsExisting() {
      return isOxkioMember()
        && resource.data.user is string
        && resource.data.user == request.auth.uid;
    }

    // A brand-new document is being written with the caller as its owner.
    // The client can never assign a document to someone else's uid.
    function createsForSelf() {
      return isOxkioMember()
        && request.resource.data.user is string
        && request.resource.data.user == request.auth.uid;
    }

    // Ownership is immutable: an update may never change who owns the
    // document, even when the caller already owns it.
    function keepsOwnership() {
      return request.resource.data.user == resource.data.user;
    }

    match /tareas/{docId} {
      allow create: if createsForSelf();
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && keepsOwnership();
    }

    match /config/{docId} {
      allow create: if createsForSelf();
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && keepsOwnership();
    }

    match /documentos/{docId} {
      allow create: if createsForSelf();
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && keepsOwnership();
    }

    match /incidencias/{docId} {
      allow create: if createsForSelf();
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && keepsOwnership();
    }

    match /reglas/{docId} {
      allow create: if createsForSelf();
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && keepsOwnership();
    }

    match /bitacora/{docId} {
      allow create: if createsForSelf();
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && keepsOwnership();
    }

    match /drive/{docId} {
      allow create: if createsForSelf();
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && keepsOwnership();
    }

    // Default deny: any collection not explicitly listed above (present or
    // added later) is closed until it is audited and given its own rule.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
