GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
# Google OAuth token persistence backend: file (default, local dev) or
# secret_manager (Cloud Run runtime). See backend/integrations/
# google-oauth-token-store.js. Leave unset locally to keep today's behavior.
OXKIO_GOOGLE_OAUTH_TOKEN_STORE=file
# Required only when OXKIO_GOOGLE_OAUTH_TOKEN_STORE=secret_manager. Full
# Secret Manager resource name, e.g. projects/<project>/secrets/<secret> —
# never the token value itself.
OXKIO_GOOGLE_OAUTH_TOKENS_SECRET=
SAFE_DRAFT_ONLY=true
OPENAI_API_KEY=

# Ruta raíz autorizada para discovery de productos XANTALAL
KNOWLEDGE_DISCOVERY_ROOT=C:\Users\janta\OneDrive\Documentos\XANTALAL\10_PRODUCTS
